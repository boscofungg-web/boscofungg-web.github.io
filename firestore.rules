rules_version = '2';

// ===================================================================
//  Firestore 安全規則 — 每週固定時間表
//  貼落：Firebase 主控台 → Firestore Database → 規則 → 發布
//
//  容許：
//    * 任何人「讀」課堂        —— 學生要睇到你幾時得閒
//    * 任何人「新增」課堂      —— 學生要可以預約
//    * 任何人「改／刪」課堂    —— 學生要可以取消自己嗰個
//
//  擋住：
//    * 格式唔啱、欄位唔齊、型別錯嘅垃圾資料
//    * 超長文字（有人想用嚟塞爆你個免費額度）
//    * lessons 以外嘅任何 collection
//
//  ⚠️ 呢套規則適合「細規模、你識得晒班學生」嘅情況。
//     佢驗證資料格式，但唔會驗證「係邊個」喺度刪嘢 —— 規則層面睇唔到人。
//     如果條網址會流出去畀陌生人，就要加 Firebase Authentication，
//     再喺 update / delete 度校驗 request.auth.uid。
// ===================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 一堂課嘅合法格式
    function isWellFormed(d) {
      return d.keys().hasOnly(['title','who','kind','note','start','end',
                               'repeat','dow','date','from','until',
                               'ltype','skip','status','createdAt'])
          && d.keys().hasAll(['title','start','end','repeat','status'])

          && d.title is string && d.title.size() > 0 && d.title.size() <= 40

          && d.start is number && d.start >= 0 && d.start < 1440
          && d.end   is number && d.end > d.start && d.end <= 1440

          && d.repeat is bool
          && d.status in ['busy', 'tentative']

          // 每週重複 → 要有合法星期；單次 → 要有 YYYY-MM-DD
          && (d.repeat
                ? (d.dow is number && d.dow >= 0 && d.dow <= 6)
                : (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))

          // 重複課堂嘅開始／結束日：空字串 = 冇限制（舊資料就係咁）
          && (!('from'  in d.keys()) || d.from  == '' || d.from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && (!('until' in d.keys()) || d.until == '' || d.until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))

          // 課堂類型（用嚟計錢嗰個）。空字串 = 唔計。加新類型記得加埋落呢度。
          && (!('ltype' in d.keys()) || d.ltype == ''
              || d.ltype in ['lighthouse', 'primary', 'sail'])

          // 顏色分類。加新分類記得把個 key 加埋落呢度，否則 Firebase 會拒收
          && (!('kind' in d.keys()) || d.kind in ['uni', 'work', 'other', 'open', 'admin'])

          && (!('who'  in d.keys()) || (d.who  is string && d.who.size()  <= 30))
          && (!('note' in d.keys()) || (d.note is string && d.note.size() <= 40))
          && (!('skip' in d.keys()) || (d.skip is list && d.skip.size() <= 200))
          && (!('createdAt' in d.keys()) || d.createdAt is number);
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update: if isWellFormed(request.resource.data);
      allow delete: if true;
    }

    // 其他一律唔准掂
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
